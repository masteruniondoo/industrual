{
    "name": "industrial-sensor",
    "version": "0.13.5",
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "next dev",
        "account:create": "node scripts/create-account.mjs",
        "contract:deploy": "node scripts/deploy-actuator-contract.mjs",
        "build": "next build",
        "typecheck": "tsc --noEmit --incremental false",
        "test": "vitest run",
        "login:devnet": "pad login",
        "whoami:devnet": "pad whoami",
        "check:devnet": "node scripts/devnet.mjs --check",
        "predeploy:devnet": "npm run build",
        "deploy:devnet": "node scripts/devnet.mjs",
        "deploy:devnet:secure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-with-mnemonic.ps1"
    },
    "dependencies": {
        "@parity/product-sdk-chain-client": "0.12.3",
        "@parity/product-sdk-contracts": "0.10.7",
        "@parity/product-sdk-descriptors": "0.11.0",
        "@parity/product-sdk-host": "0.19.1",
        "@parity/product-sdk-signer": "0.14.4",
        "@parity/product-sdk-statement-store": "^0.6.9",
        "@parity/product-sdk-tx": "0.4.7",
        "@polkadot/util-crypto": "13.5.9",
        "next": "16.3.4",
        "polkadot-api": "^2.1.7",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}
