{
    "name": "industrial-actuator-contract",
    "version": "0.1.0",
    "private": true,
    "description": "Warehouse actuator payment trigger for Polkadot Products Devnet",
    "author": "Parity Technologies",
    "homepage": "https://github.com/paritytech/contract-dependency-manager",
    "repository": {
        "type": "git",
        "url": "https://github.com/paritytech/contract-dependency-manager"
    },
    "scripts": {
        "build": "hardhat compile",
        "cdm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cdm.ps1",
        "cdm:build:devnet": "npm run cdm -- build -n devnet",
        "clean": "hardhat clean",
        "test": "hardhat test --config hardhat.test.config.ts"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-toolbox": "^6.1.0",
        "@parity/hardhat-polkadot": "^0.3.0",
        "@types/node": "^22.15.3",
        "hardhat": "^2.26.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "pnpm": {
        "overrides": {
            "axios": "^1.16.1",
            "serialize-javascript": "^7.0.5"
        }
    }
}
